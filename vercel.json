{
  "rewrites": [
    { "source": "/projects/:id", "destination": "/projects/:id/index.html" }
  ],
  "redirects": [
    { "source": "/projects", "destination": "/#projects", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
